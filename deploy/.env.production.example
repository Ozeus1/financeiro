# Modelo de .env.production — copie para flask/.env.production e preencha
# NUNCA commite o arquivo real no GitHub!

FLASK_ENV=production
SECRET_KEY=gere_com__python3_-c_"import secrets; print(secrets.token_hex(32))"
DEBUG=False

# PostgreSQL (nome do serviço Docker: finan_db)
DATABASE_URL=postgresql://finan_user:SENHA_SEGURA@finan_db:5432/finan_db
DB_USER=finan_user
DB_PASSWORD=SENHA_SEGURA
DB_NAME=finan_db

# Integrações opcionais
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
